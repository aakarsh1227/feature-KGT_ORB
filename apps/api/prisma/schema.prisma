datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// KGT AI Hub: a multi-tenant Support + Sales chatbot platform. Every
// customer company is a Tenant; all of its documents, chats, tickets, usage
// and API keys hang off that row and cascade with it.

// Platform staff who manage tenants in the operator console (apps/web).
// Created by prisma/seed.js from HUB_ADMIN_EMAIL / HUB_ADMIN_PASSWORD.
model Operator {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Tenant {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  industryLabel     String   // e.g. "Retail Customer Support", "IT Helpdesk" — shown to the model as its role
  persona           String?  // optional extra tone/rules text layered onto the generic template
  outOfScopeMessage String   @default("I'm your dedicated assistant here, and I want to make sure you get the very best care for this particular request. Would you like me to drop a quick note for our team so they can follow up with you directly?")
  minConfidence     Float    @default(0.30)
  active            Boolean  @default(true)
  // Set when provisioned via the public self-serve wizard; null for a
  // staff-created tenant. Unique: one self-serve company per email address
  // (migration 20261011090000_one_account_per_email).
  signupEmail       String?  @unique
  // Which bots the company deploys: support | sales | both (CHECK constraint
  // in migration 20261010090000_bot_preference). With one bot, that bot uses
  // all of the knowledge and the readiness audit judges only its scope
  // (services/shared/botScope.js, services/botAuditor.js).
  botPreference     String   @default("both")
  // The company's business category, chosen in the onboarding wizard
  // (ecommerce | saas | healthcare | real_estate | services | other). Drives
  // the tailored upload prompts and a light tone hint for the bots
  // (services/shared/businessCategory.js). Null for tenants created before it.
  businessCategory  String?
  // Where lead and low-confidence alerts go (services/teamAlerts.js). Null =
  // the signup email, then the tenant's dashboard users. Lower-cased.
  teamEmail         String?
  // Pre-flight knowledge audit (services/botAuditor.js): the latest report,
  // its 0-100 score and level, and a hash of the documents it judged — a
  // different hash now means documents changed since and the report is stale.
  readinessScore       Int?
  readinessLevel       String?   // Not Ready | Moderate | Production Ready
  readinessReport      Json?
  readinessContentHash String?
  readinessAuditedAt   DateTime?
  createdAt         DateTime @default(now())

  users        TenantUser[]
  documents    TenantDocument[]
  apiKeys      TenantApiKey[]
  consents     TenantConsent[]
  chatSessions ChatSession[]
  tickets      SupportTicket[]
  leads        Lead[]
  usageLogs    UsageLog[]
  starterFaqs  TenantFaq?
  smtpConfig   TenantSmtpConfig?
  products     ProductCatalog[]
}

// Structured product rows from a catalog CSV upload (services/catalogIngest.js).
// Stored alongside the readable TenantDocument the CSV is also turned into, so
// the existing RAG can answer price/product questions from its text while
// these rows keep the exact, queryable data. Strictly tenant-scoped; deleting
// the source document cascades its rows away.
model ProductCatalog {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  document    TenantDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String?
  name        String
  sku         String
  price       String          // kept as text: currencies, ranges and "POA" are all valid
  description String          @default("")
  category    String?         // the item's own category/type (e.g. "Electronics", "Course"), not the tenant's business category
  imageUrl    String?         // an image/picture URL for the product or course
  productUrl  String?         // a direct product / purchase / checkout link shown on the card
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, sku])
}

// A tenant's own outbound SMTP, so ticket alerts, lead emails and other
// notifications go out from their domain instead of the platform mailbox
// (services/mailer.js falls back to the global SMTP when this is absent or
// disabled). smtpPass is stored ONLY as AES-256-GCM ciphertext
// (utils/encryption.js) and is never returned to the client — the API masks
// it. One row per tenant.
model TenantSmtpConfig {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String   @unique
  provider  String?  // 'gmail' | 'outlook' | null (custom) — drives the UI's provider picker and help text
  smtpHost  String
  smtpPort  Int      @default(587)
  smtpUser  String
  smtpPass  String   // AES-256-GCM ciphertext (never plaintext, never sent to the client)
  smtpFrom  String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Starter questions for the Test Bots sandbox, written by an LLM from this
// tenant's own documents (services/tenantFaqs.js) after a website import,
// PDF upload or signup. One row per tenant; regenerating overwrites it.
// status: pending (generation queued/running) | ready | failed. A failed
// regeneration keeps the previous questions, so the sandbox never goes blank.
model TenantFaq {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String    @unique
  supportFaqs String[]  @default([]) // English starter questions (index-aligned with the *Hi arrays)
  salesFaqs   String[]  @default([])
  supportFaqsHi String[] @default([]) // Hindi variants, same order; falls back to English where a translation is missing
  salesFaqsHi   String[] @default([])
  status      String    @default("pending")
  error       String?   // last failure reason, for staff; never shown to clients
  generatedAt DateTime? // when the current questions were written
  updatedAt   DateTime  @updatedAt
}

// A client company's own login to its dashboard (/dashboard). Belongs to
// exactly one tenant and can only ever see that tenant's data: the client
// JWT carries this user's id, and middleware/clientAuth.js resolves the
// tenant from the database row, never from anything the client sends.
// Created by the signup wizard (/api/v1/public/register/complete).
model TenantUser {
  id                String    @id @default(uuid())
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String
  // One account per email address. Always stored lower-cased and trimmed
  // (CHECK constraint in migration 20261011090000_one_account_per_email), so
  // "Ana@Acme.com" and "ana@acme.com" can never become two accounts.
  email             String    @unique
  name              String?
  passwordHash      String
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?
  // Sessions issued before this moment are rejected (middleware/clientAuth.js),
  // so resetting a password signs the account out everywhere.
  passwordChangedAt DateTime?

  resetCodes PasswordResetCode[]

  @@index([tenantId])
}

// One-time 6-digit code for the forgot-password flow (routes/clientAuth.routes.js).
// Only a hash of the code is stored; it expires after 10 minutes, locks after
// 5 wrong attempts, and is single-use. Requesting a new code voids older ones.
model PasswordResetCode {
  id        String     @id @default(uuid())
  user      TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
}

// Proof that a signup email address belongs to the person signing up
// (services/verificationService.js). One row per address: requesting a new
// code replaces the old one. Only an HMAC of the 6-digit code is stored;
// it expires after 10 minutes and locks after 5 wrong attempts. Once
// verified it's valid for 2 hours and is consumed (usedAt) by the
// /register/complete call that creates the account.
model EmailVerification {
  id         String    @id @default(uuid())
  email      String    @unique // lower-cased
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  usedAt     DateTime?
  lastSentAt DateTime  @default(now()) // drives the resend cooldown
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Widget/API credentials. Only a SHA-256 hash of each key is stored — the
// plaintext is shown once when issued (utils/tenantApiKeys.js) and can't be
// recovered, only rotated. Several keys per tenant, so a key can be replaced
// without downtime: issue the new one, update the embed, then revoke the old.
model TenantApiKey {
  id         String    @id @default(uuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  keyHash    String    @unique // sha256 hex of the full plaintext key
  keyPrefix  String    // first chars of the key, e.g. "tk_3f9a1c" — lets admins tell keys apart
  label      String    @default("Default")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // updated at most every few minutes, not on every request
  revokedAt  DateTime? // non-null = rejected; kept for the audit trail rather than deleted

  @@index([tenantId])
}

enum ConsentKind {
  WEBSITE_CRAWL // visitor certified they may authorize crawling this domain
}

// Audit record of an authorization the visitor gave during self-serve signup.
// statement is the server's copy of the text at statementVersion, not whatever
// the client sent, so the record reflects what we actually asked people to agree to.
model TenantConsent {
  id               String      @id @default(uuid())
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String
  kind             ConsentKind
  domain           String?     // the crawled host, for WEBSITE_CRAWL
  statement        String
  statementVersion String
  email            String      // who gave it (the signup email)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime    @default(now())

  @@index([tenantId])
}

// Universal 3-tier knowledge taxonomy (sector-neutral). Mirrored as string
// constants in src/services/shared/documentCategory.js — keep in sync.
enum DocumentCategory {
  CORE_OVERVIEW // who the company is, what it offers, positioning
  FAQ           // question/answer content, troubleshooting
  CUSTOM_POLICY // pricing, policies, terms, manuals, spec sheets
}

// Mirrored as DOC_SCOPES in src/services/shared/botScope.js — keep in sync.
enum BotScope {
  AUTO    // each section classified on its own
  BOTH    // both bots
  SUPPORT // Support Bot only
  SALES   // Sales Bot only
}

model TenantDocument {
  id         String           @id @default(uuid())
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  title      String
  content    String           // plain markdown/text — parsed into chunks the same way docs/*.md files are
  category   DocumentCategory @default(CORE_OVERVIEW) // drives per-bot retrieval weighting (domains/tenantProfile.js)
  sourceUrl  String?          // set when this document came from the auto-scraper; null for a hand-authored one
  // Which bot may use it (services/shared/botScope.js): AUTO classifies each
  // section separately; BOTH / SUPPORT / SALES apply to the whole document.
  botScope   BotScope         @default(AUTO)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  products   ProductCatalog[]

  @@index([tenantId])
  @@index([tenantId, category])
}

// One conversation with one visitor. botType, lastMessageAt and messageCount
// are kept up to date on every turn (services/tenantChat.js). summary is the
// AI summary of the whole conversation (services/chatSessions.js), written
// once it goes idle or ends; for a conversation that produced a lead, the
// lead's summary (services/leads.js) is copied here instead of a second call.
model ChatSession {
  id             String    @id @default(uuid())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  externalUserId String?   // identity from whatever host app is embedding the widget — opaque to us
  startedAt      DateTime  @default(now())
  // support | sales — the bot of the first turn (CHECK constraint in
  // migration 20261016090000_session_summaries_team_alerts)
  botType        String?
  lastMessageAt  DateTime?
  messageCount   Int       @default(0)
  endedAt        DateTime? // the widget reported the page closed (POST /session/end)
  summary        String?
  summaryStatus  String    @default("none") // none | pending | ready | failed
  summarizedAt   DateTime? // when the last attempt finished; older than lastMessageAt = stale
  // Lease taken when an API instance starts writing this conversation's
  // summary. The claim is what stops two instances paying for the same
  // summary twice (services/chatSessions.js); a claim older than
  // SESSION_SUMMARY_LEASE_MIN means the holder died mid-run, so the
  // conversation becomes claimable again instead of being stuck pending.
  summaryClaimedAt DateTime?
  messages       ChatMessage[]

  @@index([tenantId])
  @@index([tenantId, lastMessageAt])
  @@index([lastMessageAt])
}

model ChatMessage {
  id         String      @id @default(uuid())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  role       String      // user | assistant
  content    String
  confidence Float?      // the gate score behind this assistant reply, if applicable
  // support | sales — which bot this turn went to; null on rows from before
  // per-bot tracking. CHECK constraint in migration 20261002090000_bot_type_check.
  botType    String?
  // true on an assistant reply the model wrote from the knowledge base; false
  // on greetings, handoffs, "can't answer that" and outage replies. The
  // visitor's confirmation email recaps only these (services/leads.js).
  answered   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([sessionId])
}

model SupportTicket {
  id         String   @id @default(uuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  query        String
  transcript   Json     // recent turns, for whoever picks this up
  confidence   Float?   // the score below the handoff threshold; null for requests (demo, human, contact)
  // unanswered | outage | human_request | demo_request | contact_request
  // (CHECK constraint in migration 20261002120000_conversational_handoffs)
  kind         String   @default("unanswered")
  botType      String?  // support | sales
  sessionId    String?  // the conversation, so an email left later attaches here
  contactEmail String?  // left by the visitor in the chat
  status       String   @default("open")
  createdAt    DateTime @default(now())

  @@index([tenantId, status])
  @@index([tenantId, sessionId])
}

enum LeadStatus {
  NEW       // not yet followed up
  CONTACTED // someone on the tenant's team has reached out
}

// A visitor who left an email in a bot conversation (services/leads.js).
// One row per conversation, bot and email: leaving the same email again
// updates it rather than adding another. fullTranscript and chatSummary are
// rewritten in the background as the conversation goes on, so the summary
// covers what was said after the email too.
model Lead {
  id                 String     @id @default(uuid())
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId           String
  // support | sales (CHECK constraint in migration 20261005090000_leads)
  botType            String
  sessionId          String?    // the ChatSession the email was left in
  email              String
  chatSummary        String?    // the LLM's executive summary; null until one is written
  summaryStatus      String     @default("pending") // pending | ready | failed
  fullTranscript     Json       @default("[]") // [{ role, content, botType, at }], oldest first
  status             LeadStatus @default(NEW)
  confirmationSentAt DateTime?  // when the "we've received your request" email went out
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, sessionId])
  @@index([tenantId, email])
}

// One row per answer that would have cost an LLM call: a real call, or a
// repeat question served from the in-memory answer cache (engine/answerCache.js).
// A cache hit records 0 tokens and $0, and what the original call cost in
// savedTokens / savedCostUsd, so dashboards can show what the cache saved.
model UsageLog {
  id               String   @id @default(uuid())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String
  // support | sales for chat answers; null for platform work done for the
  // tenant (starter-FAQ generation) and for rows from before per-bot tracking.
  // CHECK constraint in migration 20261002090000_bot_type_check.
  botType          String?
  provider         String   // groq | openai | anthropic | cache
  model            String
  promptTokens     Int
  completionTokens Int
  estimatedCostUsd Float    @default(0)
  cacheHit         Boolean  @default(false)
  savedTokens      Int      @default(0)
  savedCostUsd     Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, botType, createdAt])
}
