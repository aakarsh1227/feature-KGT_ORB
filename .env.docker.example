# Copy to .env.docker and fill in. Deploy with:
#   docker compose --env-file .env.docker up -d --build
# VM ports already taken by other services: 3001-3005, 4000, 5433-5434, 5678,
# 8000-8002, 15432, 55432, 16379

# ── Ports (host side) ───────────────────────────────────────────────
API_PORT=4100
WEB_PORT=3100
POSTGRES_PORT=5440

# Browser-facing API URL, baked into the web app at BUILD time (rebuild with
# --build after changing it). The embed snippet shown after signup also points
# here, so production must use the public URL. Read by compose itself, so
# start compose with --env-file .env.docker. Unset = https://api.kgt.solutions.
# This value is for a stack running on your own machine only:
PUBLIC_API_URL=http://localhost:4100

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=kgthub
POSTGRES_PASSWORD=kgthub
POSTGRES_DB=kgthub

# ── Auth ────────────────────────────────────────────────────────────
# Signs operator console sessions. Set a long random value in production
# (e.g. `openssl rand -hex 32`); with DEPLOY_ENV=production the API refuses
# to start on the placeholder.
JWT_SECRET=dev-secret-change-me
# DEPLOY_ENV=production

# Master key for encrypting secrets stored in the database — currently each
# tenant's custom SMTP password (apps/api/src/utils/encryption.js, AES-256-GCM).
# Any length works (a 32-byte key is derived from it); use a long random value,
# e.g. `openssl rand -hex 32`. Required only to use the custom-SMTP feature; if
# it is unset, the Email settings page reports that secure storage is
# unavailable and mail falls back to the platform SMTP below. Rotating it makes
# existing stored SMTP passwords unreadable — re-enter them after a change.
ENCRYPTION_KEY=

# Browser origins allowed to call the dashboard, staff and signup APIs
# (comma-separated). The chat widget API stays open to every origin.
# The local dev origins (localhost:3000, :3001, :3100) are ALWAYS allowed in
# addition to whatever is listed here — including when DEPLOY_ENV=production,
# which the local docker-compose stack sets — so you never need to add them.
# Required with DEPLOY_ENV=production so the deployed web app is allowed.
# CORS_ORIGINS=https://hub.example.com
# Proxy hops in front of the API (default 1): how many proxies sit between a
# visitor and the API and append to X-Forwarded-For. Express reads req.ip from
# that chain, and EVERY per-IP rate limit depends on it, so a wrong value is
# quiet and expensive: too low and all visitors land in one shared bucket, too
# high (or 0 with the port exposed directly) and a visitor can spoof
# X-Forwarded-For to get a fresh bucket per request.
#
# Count the proxies, including the nginx load balancer in docker-compose.yml:
#   visitor -> nginx -> api                      TRUST_PROXY_HOPS=1
#   visitor -> your TLS terminator -> nginx -> api   TRUST_PROXY_HOPS=2
# If unsure, check it rather than guess: hit the API through your real
# entrypoint twice with distinct X-Forwarded-For values and confirm they get
# separate rate-limit budgets (apps/api/test/system/rateLimits.test.js is the
# same check, in test form).
TRUST_PROXY_HOPS=1

# ── Running more than one API container ─────────────────────────────
# The API is stateless, so it can run as several containers behind the nginx
# load balancer in docker-compose.yml — a deploy, a crash or an OOM kill then
# never takes every tenant's chatbot offline.
#
# This is only correct with SHARED_STORE=redis. The state the containers must
# agree on (rate-limit windows, knowledge invalidation, alert throttles,
# background-job locks) lives in apps/api/src/lib/sharedStore.js; with the
# default `memory` driver each container keeps its own copy, which means:
#   - every rate limit becomes N times looser;
#   - a document edited on one container leaves the others answering from the
#     knowledge they had cached, with nothing to ever clear it;
#   - two containers pay for the same readiness audit or FAQ generation;
#   - the signup wizard's reviewed report is lost whenever /complete lands on
#     a different container than /preflight-audit.
# So: more than one replica REQUIRES redis. One replica may use either.
API_REPLICAS=2
SHARED_STORE=redis
REDIS_URL=redis://redis:6379

# Postgres connections per API container. Prisma's default is
# (num_cpus * 2 + 1) per process, which several replicas on a many-core host
# multiply past Postgres max_connections (100 by default) — the symptom is
# random "too many clients" errors. Budget: API_REPLICAS x this, + 1 for the
# one-shot migrate container, under max_connections.
PRISMA_CONNECTION_LIMIT=10

# When Redis is unreachable the API degrades on purpose rather than failing:
# rate limits fail OPEN, caches are bypassed (reads go to Postgres and nothing
# cached is trusted), and background job locks are refused. It logs loudly.
# See apps/api/src/lib/sharedStore/redisDriver.js to change those trade-offs.

# First operator account, created on first start (prisma/seed.js). Existing
# operators are never overwritten by re-seeding.
HUB_ADMIN_EMAIL=admin@example.com
HUB_ADMIN_PASSWORD=change-me-please
HUB_ADMIN_NAME=Platform admin
RUN_SEED=true
# Showcase tenant #1: FLATBRIZ, seeded on first start with its support
# manuals and sales material (apps/api/prisma/seed-data/flatbriz). Set to
# false for a platform with no pre-installed tenant.
SEED_FLATBRIZ_TENANT=true
# Pin the key the Flatbriz embed uses, so it never changes across restarts or
# redeploys. Generate once:  echo "tk_$(openssl rand -hex 24)"
# Leave empty to have a random key issued on first start and printed once in
# the API logs (docker logs kgt-ai-hub-api | grep "API key").
FLATBRIZ_TENANT_API_KEY=

# ── LLM providers ───────────────────────────────────────────────────
# LLM_PRIMARY is tried first, then each of LLM_FALLBACK in order. At least
# ONE key is required, or every chat reply is a degraded raw-excerpt
# fallback; the API logs a [llm] WARNING at startup when none is set.
LLM_PRIMARY=groq
LLM_FALLBACK=openai,anthropic
CHAT_TEMPERATURE=0.35
# Groq retires models regularly; the API logs at startup whether this one is
# available to your key, and lists the ones that are.
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Per-provider request timeout before failing over to the next provider.
LLM_TIMEOUT_MS=20000
# Completion budget per reply. Reasoning models (gpt-oss) spend part of it on
# hidden reasoning, so keep it at 1024 or more.
LLM_MAX_TOKENS=1024
# gpt-oss on Groq: low | medium | high. Low is fast and enough for grounded Q&A.
LLM_REASONING_EFFORT=low

# ── Tenant chat limits ──────────────────────────────────────────────
# Requests per tenant per window, shared by the Support and Sales bots.
# This is abuse protection, not capacity: the window is shared by ALL of that
# company's visitors at once, and its own dashboard test chat draws from the
# same bucket. 300/10min is ~30 messages a minute for a whole website; the old
# default of 30 was 3 a minute and turned real visitors away. Retrieval costs
# well under a millisecond per turn (apps/api/scripts/bench-retrieval.js), so
# what this protects is the LLM bill, not the server.
TENANT_CHAT_RATE_LIMIT_MAX=300
TENANT_CHAT_RATE_LIMIT_WINDOW_MIN=10

# Cached answers, shared across every tenant: a repeat question costs nothing
# (engine/answerCache.js). Divide by tenant count for the rough per-company
# budget, and raise it as companies are added — each eviction is one more paid
# LLM call the next time that question is asked.
# ANSWER_CACHE_MAX_ENTRIES=20000
# ANSWER_CACHE_TTL_HOURS=24
# ANSWER_CACHE_ENABLED=true

# ── Email (SMTP) ────────────────────────────────────────────────────
# Password-reset codes, and the confirmation a visitor gets after leaving
# their address with a bot (with a recap of the bot's answers). Only the
# visitor is emailed; the team reads leads under Leads & Summaries. The API
# logs at startup whether it could log in. Without SMTP_HOST, no mail is sent
# (outside production it's printed to the API log instead).
SMTP_HOST=smtp.office365.com
# 587 = STARTTLS (required, never plaintext); 465 = implicit TLS.
SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=connect@kgt.solutions
# Microsoft 365 with MFA: an app password, not the mailbox password; the
# mailbox needs Authenticated SMTP enabled. Secret — keep it only in
# .env.docker, never in this file or the repo.
SMTP_PASS=
# Must be the same mailbox as SMTP_USER (Microsoft 365 rejects anything else).
SMTP_FROM="KGT Solutions <connect@kgt.solutions>"
# Hours before the same address can get another confirmation email (anti-spam:
# the chat widget is public). Default 24 in production, 0 elsewhere. Set 0
# temporarily to re-test with one address on a production-mode container;
# the API logs a warning at startup while it's off.
# LEAD_CONFIRMATION_COOLDOWN_HOURS=24
# Seconds of quiet in a conversation before its lead summary is rewritten.
# LEAD_SUMMARY_IDLE_SEC=120

# ── Session summaries & team alerts ─────────────────────────────────
# Every conversation gets an AI summary once it's been quiet this long (or
# when the visitor leaves the page); a worker checks every SWEEP seconds and
# only looks back LOOKBACK hours, so old chats are never summarized in bulk.
# SESSION_SUMMARY_IDLE_SEC=120
# SESSION_SUMMARY_SWEEP_SEC=60
# SESSION_SUMMARY_LOOKBACK_HOURS=24
# Conversations summarized per sweep. BATCH / SWEEP_SEC is the platform-wide
# ceiling: 30 every 60s is 1800 an hour across all tenants. Past the ceiling the
# backlog grows and conversations age out of LOOKBACK_HOURS unsummarized, so
# raise this as companies are added rather than shortening the sweep.
# SESSION_SUMMARY_BATCH=30
# How long one API instance's claim on a conversation is honoured before
# another may take it over (ChatSession.summaryClaimedAt). Only matters when
# more than one instance runs: it is what stops two of them paying for the same
# summary. Must comfortably exceed the slowest LLM reply, or two instances will
# overlap; too long and a container killed mid-summary parks that conversation
# until the lease lapses.
# SESSION_SUMMARY_LEASE_MIN=10
# Each tenant's team is emailed on a new lead, a handoff, or an answer below
# this confidence. Recipients are set per tenant on Leads & Summaries
# (default: the signup email). Throttled per conversation and per tenant.
# Keep these low: correct answers normally score 33-50% (engine/confidence.js).
# TEAM_ALERTS_ENABLED=true
# LOW_CONFIDENCE_ALERT_BELOW=0.25
# Improvements tab: replies under this, or with no knowledge-base answer.
# IMPROVEMENT_CONFIDENCE_BELOW=0.25
# ALERT_SESSION_COOLDOWN_MIN=30
# ALERT_TENANT_MAX_PER_HOUR=20
# Public dashboard URL, for the "Open in the dashboard" button in alerts.
# DASHBOARD_URL=https://hub.example.com

# ── Crawler ─────────────────────────────────────────────────────────
# Tier 2: headless Chromium for JS-only sites and bot-blocked pages. Only
# the operator "Auto-train from website URL" route uses it; the public
# signup wizard never does. Set to false to turn it off without a rebuild.
CRAWLER_BROWSER_ENABLED=true
